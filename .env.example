# Salin menjadi .env untuk mencoba koneksi Supabase dari komputer sendiri.
# JANGAN commit .env. Di Vercel, isi nilai yang sama di Settings -> Environment Variables.

# Connection string Postgres dari Supabase: Project Settings -> Database ->
# Connection string -> "Transaction pooler" (port 6543). Berisi sandi basis data.
DATABASE_URL=

# Kunci untuk membuka /peneliti. Buat sendiri, panjang dan acak.
PA_KUNCI_PENELITI=
